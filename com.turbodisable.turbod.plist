<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.turbodisable.turbod</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/turbodisable/turbod</string>
    </array>

    <!-- Start at boot and stay resident: it re-applies the stored state
         after every wake, which is what removes the password prompts. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/turbodisable/turbod.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
